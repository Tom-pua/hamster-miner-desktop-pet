<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌宠矿工 · 冒险手册" Width="1080" Height="740" MinWidth="980" MinHeight="660"
        Background="#0C1417" Foreground="#F5F2E8" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#111E22" Offset="0"/><GradientStop Color="#0B1215" Offset="0.58"/><GradientStop Color="#172328" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#223439" Offset="0"/><GradientStop Color="#172529" Offset="1"/>
    </LinearGradientBrush>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2A4045"/><Setter Property="Foreground" Value="#EDF3F1"/>
      <Setter Property="BorderBrush" Value="#49646A"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonShell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonShell" Property="Opacity" Value="0.84"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonShell" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#8FA3A2"/><Setter Property="Background" Value="#17262A"/>
      <Setter Property="Padding" Value="21,11"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabShell" Background="{TemplateBinding Background}" BorderBrush="#355057" BorderThickness="1" CornerRadius="7,7,0,0" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabShell" Property="Background" Value="#294147"/><Setter TargetName="TabShell" Property="BorderBrush" Value="#59DCC8"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabShell" Property="BorderBrush" Value="#7DEBDA"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#FFE6A6"/><Setter Property="Background" Value="#294147"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#59DCC8"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardGradient}"/><Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BorderBrush" Value="#3B555B"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="7"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="13" ShadowDepth="3" Opacity="0.24" Color="#020607"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="CornerRadius" Value="12"/><Setter Property="Background" Value="#22363B"/>
      <Setter Property="BorderBrush" Value="#3F5A60"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="4"/>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="16"/><Setter Property="Background" Value="#101B1E"/><Setter Property="Foreground" Value="#59DCC8"/>
      <Setter Property="BorderBrush" Value="#405B60"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#101B1E"/><Setter Property="Foreground" Value="#D8E1DF"/>
      <Setter Property="BorderBrush" Value="#3B555B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="6"/>
    </Style>
  </Window.Resources>

  <Grid Background="{StaticResource WindowGradient}">
    <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#C9122024" BorderBrush="#345057" BorderThickness="0,0,0,1">
      <Grid Margin="25,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Border Width="39" Height="39" CornerRadius="10" Background="#274A47" BorderBrush="#59DCC8" BorderThickness="1" Margin="0,0,13,0">
              <TextBlock Text="⛏" FontFamily="Segoe UI Symbol" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFE6A6"/>
            </Border>
            <StackPanel>
              <TextBlock Text="桌宠矿工" FontSize="26" FontWeight="ExtraBold" Foreground="#FFF8E8"/>
              <TextBlock Text="PROJECT DEEP DESK · 冒险手册" FontSize="9" Foreground="#59DCC8" FontWeight="Bold"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource Badge}"><TextBlock x:Name="HeaderFunds" Foreground="#FFE6A6" FontWeight="Bold"/></Border>
          <Border Style="{StaticResource Badge}"><TextBlock x:Name="HeaderSkill" Foreground="#59DCC8" FontWeight="Bold"/></Border>
          <Border Style="{StaticResource Badge}"><TextBlock x:Name="HeaderDepth" Foreground="#C0CDCB" FontWeight="Bold"/></Border>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="AdventureTabs" Grid.Row="1" Margin="20,14,20,8" Background="Transparent" BorderThickness="0">
      <TabItem Header="矿井战报">
        <Grid Margin="7"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="当前战区" Foreground="#6F8989" FontSize="10" FontWeight="Bold"/>
                <TextBlock x:Name="MineDepth" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/>
                <TextBlock x:Name="MineTarget" FontSize="30" FontWeight="ExtraBold" Margin="0,12,0,5"/>
                <TextBlock x:Name="MineHp" Foreground="#A8BAB8"/>
                <ProgressBar x:Name="MineHpBar" Margin="0,11,0,9" Minimum="0" Maximum="100"/>
                <TextBlock x:Name="MineMechanics" Foreground="#90A5A3"/>
                <Border Background="#172225" BorderBrush="#345056" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,14,0,0">
                  <TextBlock x:Name="AttackDamageText" Foreground="#59DCC8" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                </Border>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel><TextBlock Text="本轮收获" Foreground="#8CA09F"/><TextBlock x:Name="MineWarehouseValue" Foreground="#FFE6A6" FontSize="19" FontWeight="ExtraBold" Margin="0,8,0,0"/><TextBlock x:Name="MineWarehouse" Foreground="#59DCC8" FontSize="16" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <Border Style="{StaticResource Card}">
              <StackPanel><TextBlock Text="升降梯 · 返回地面" FontSize="17" FontWeight="Bold"/>
                <TextBlock x:Name="ReturnPreview" Foreground="#A6B7B5" LineHeight="28" Margin="0,12"/>
                <Button x:Name="ConfirmReturnButton" Content="呼叫升降梯" Background="#59DCC8" Foreground="#102022" BorderBrush="#79F2DF" FontWeight="Bold"/>
                <Button x:Name="DescendButton" Content="整备完成 · 再次下矿" Background="#FFE6A6" Foreground="#241D10" BorderBrush="#FFF0C2" FontWeight="Bold" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel><TextBlock Text="矿队状态" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="BuildInfo" Foreground="#A6B7B5" LineHeight="27" Margin="0,10"/><Button x:Name="PanelPauseButton" Content="暂停挖矿"/></StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="技能星图">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <Grid Margin="7,0,7,13"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="三脉技能星图" FontSize="22" FontWeight="ExtraBold"/><TextBlock Text="首次抵达 70、140、210…层时各获得 1 点；回挖不重复。" Foreground="#8EA3A1" Margin="0,5,0,0"/><TextBlock x:Name="SkillSummary" Foreground="#59DCC8" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
              <Button x:Name="ResetSkillsButton" Grid.Column="1" Content="免费重置技能点" Background="#9A72E8" Foreground="White" BorderBrush="#BFA4F3" VerticalAlignment="Center"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel x:Name="KeyboardTreePanel" Grid.Column="0" Margin="4"/>
              <StackPanel x:Name="IdleTreePanel" Grid.Column="1" Margin="4"/>
              <StackPanel x:Name="MouseTreePanel" Grid.Column="2" Margin="4"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="伙伴营地">
        <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="矿工宠物蛋" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="EggInfo" Foreground="#A5B6B4" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
            <Button x:Name="HatchButton" Grid.Column="1" Content="唤醒新伙伴" Background="#59DCC8" Foreground="#102022" BorderBrush="#79F2DF" VerticalAlignment="Center"/>
          </Grid></Border>
          <Border Grid.Row="1" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="伙伴名册" FontSize="19" FontWeight="Bold"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10"><TextBlock x:Name="PetsList" Foreground="#B3C1BF" LineHeight="30" TextWrapping="Wrap"/></ScrollViewer>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PetUpgradeInfo" Foreground="#FFE6A6" TextWrapping="Wrap" VerticalAlignment="Center" Margin="3"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="NextPetButton" Content="切换出战"/><Button x:Name="UpgradePetButton" Content="训练当前伙伴" Background="#59DCC8" Foreground="#102022" BorderBrush="#79F2DF"/></StackPanel>
            </Grid>
          </Grid></Border>
        </Grid>
      </TabItem>

      <TabItem Header="装备工坊">
        <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="当前战斗装束" FontSize="19" FontWeight="Bold"/><Border Background="#193633" BorderBrush="#3B7A70" BorderThickness="1" CornerRadius="8" Padding="11,7" Margin="0,8,0,9"><TextBlock Text="返回地面后会自动穿上各部位属性最高的装备" Foreground="#70E5D2" FontWeight="Bold"/></Border><TextBlock x:Name="EquippedList" Foreground="#B0C0BE" LineHeight="27"/></StackPanel></Border>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid><TextBlock Text="永久背包" FontSize="19" FontWeight="Bold"/><TextBlock Text="战利品自动入库" Foreground="#728C8C" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="筛选" Foreground="#94A9A7" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="EquipmentFilter" Width="175" Height="31" Background="#F3F2E8" Foreground="#111A1D" BorderBrush="#59DCC8" Padding="7,3"/></StackPanel>
              <ListBox x:Name="InventoryListBox" Grid.Row="2" Margin="0,11,0,0" FontFamily="Microsoft YaHei UI"/>
            </Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="装备鉴定" FontSize="19" FontWeight="Bold"/><TextBlock Text="属性 / 对比 / 套装进度" Foreground="#718B8B" FontSize="10" Margin="0,3,0,0"/><Border Background="#111D20" BorderBrush="#365158" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,13,0,0"><TextBlock x:Name="SelectedItemDetails" Foreground="#B7C6C4" LineHeight="27" TextWrapping="Wrap"/></Border></StackPanel></Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="收藏图鉴">
        <ScrollViewer><StackPanel Margin="12">
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="矿物图鉴" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="MineralCatalog" FontSize="15" Foreground="#B1C0BE" Margin="0,13,0,0" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="伙伴图鉴" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="PetCatalog" Foreground="#B1C0BE" LineHeight="28" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="套装图鉴与永久共鸣" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="SetCatalog" Foreground="#B1C0BE" LineHeight="28" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="矿工档案">
        <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="旅程统计" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="StatsText" Foreground="#B1C0BE" LineHeight="30" Margin="0,11,0,0"/></StackPanel></Border>
          <StackPanel Grid.Column="1">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="隐私护盾" FontSize="19" FontWeight="Bold"/><TextBlock Text="只累计匿名的键盘、鼠标和挂机次数。程序不保存字符、键码、输入文字、鼠标坐标、前台应用、剪贴板或屏幕内容；所有存档仅在本机。" Foreground="#A8B9B7" TextWrapping="Wrap" LineHeight="25" Margin="0,10,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="系统启动" FontSize="19" FontWeight="Bold"/>
                <CheckBox x:Name="StartupCheckBox" Content="开机后自动启动仓鼠矿工" IsChecked="True" Foreground="#F5F2E8" FontFamily="Microsoft YaHei UI" FontSize="14" FontWeight="SemiBold" Margin="2,13,2,5" Cursor="Hand"/>
                <TextBlock Text="默认开启，仅对当前 Windows 用户生效；取消勾选后会立即移除启动项。" Foreground="#A8B9B7" TextWrapping="Wrap" LineHeight="23"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}"><StackPanel><Button x:Name="OpenSaveButton" Content="打开本地存档位置"/><Button x:Name="ExitButton" Content="退出桌宠矿工" Background="#9D4851" BorderBrush="#CF6873"/></StackPanel></Border>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>

    <Grid Grid.Row="2" Margin="25,0"><TextBlock Text="规则由 config 驱动 · 存档具备版本迁移 · 本机离线运行" Foreground="#526C6D" FontSize="9" VerticalAlignment="Center"/><TextBlock Text="DEEP DESK BUILD 12" Foreground="#526C6D" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
  </Grid>
</Window>
